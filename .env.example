
# Admin panel (/admin). Required for login to work.
ADMIN_PASSWORD=change-me
# Optional: separate secret used to sign the session cookie
ADMIN_SESSION_SECRET=

# Storage for jobs + published theme. On Vercel add the Upstash Redis integration
# (it sets these automatically). Locally, leave empty to use data/store.json.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
